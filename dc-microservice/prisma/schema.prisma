generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  schemas  = ["cd"]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model transactions {
  id          Int       @id @default(autoincrement())
  chassi      String
  username    String
  destination String
  status      String
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  vehicles    vehicles  @relation(fields: [chassi], references: [chassi], map: "fk_vehicle")

  @@schema("cd")
}

model vehicles {
  chassi       String         @id
  modelo       String
  patio        String
  created_at   DateTime?      @default(now()) @db.Timestamp(6)
  transactions transactions[]

  @@schema("cd")
}
